<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{{meta_title}}</title>
    <meta name="HandheldFriendly" content="True" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />

    {{!-- Fonts: JetBrains Mono --}}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet" />

    {{!-- Aether Arcanum styles (plain CSS, no build step needed) --}}
    <link rel="stylesheet" type="text/css" href="{{asset "styles/aether.css"}}" />

    {{ghost_head}}
</head>
<body class="{{body_class}}">

    {{!-- CSS-only mobile menu toggle --}}
    <input type="checkbox" id="ae-nav-toggle" class="ae-nav-check" aria-hidden="true" tabindex="-1" />

    <div class="ae-shell">
        {{> "ae-sidebar"}}

        <div class="ae-main">
            <div class="ae-topbar">
                <span class="ae-topbar-tag">// {{#if @site.description}}{{@site.description}}{{else}}{{@site.title}}{{/if}}</span>
                <div class="ae-topbar-actions">
                    <button type="button" class="ae-link-btn" data-ghost-search aria-label="Search">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
                        <span>SEARCH</span>
                    </button>
                    <a class="ae-link-btn" href="{{@site.url}}/rss/">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="1"/><path d="M7 10l3 2-3 2M12 15h5"/></svg>
                        <span>RSS</span>
                    </a>
                </div>
            </div>

            <main class="ae-content-area">
                {{{body}}}
            </main>

            <footer class="ae-footer">
                <span class="ae-footer-cta"><span class="ae-accent">&gt;_</span> JOIN THE JOURNEY. EXPLORE THE ARCANE.</span>
                <span class="ae-footer-meta">&copy; {{date format="YYYY"}} {{@site.title}}</span>
            </footer>
        </div>
    </div>

    {{ghost_foot}}
</body>
</html>
