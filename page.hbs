{{!< default}}
{{#post}}
<article class="ae-article {{post_class}}">
    <header class="ae-article-head">
        <h1 class="ae-article-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="ae-lede">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{#if feature_image}}
    <figure class="ae-feature"><img src="{{img_url feature_image size="l"}}" alt="{{title}}" /></figure>
    {{/if}}
    <div class="ae-content gh-content">{{content}}</div>
</article>
{{/post}}
