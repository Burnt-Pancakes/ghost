{{!< default}}

{{#is "paged"}}
<section class="ae-section">
    <h1 class="ae-page-title">// ARCHIVE</h1>
    <div class="ae-grid">
        {{#foreach posts}}{{> "ae-card"}}{{/foreach}}
    </div>
    {{pagination}}
</section>
{{else}}

{{!-- HERO --}}
<section class="ae-hero">
    <div class="ae-hero-copy">
        <h1 class="ae-headline">
            <span>EXPLORE.</span>
            <span>DECODE.</span>
            <span class="ae-accent">ASCEND.</span>
        </h1>
        <p class="ae-hero-text">
            {{#if @site.description}}{{@site.description}}{{else}}Knowledge from the edge of the unknown. Written for the curious, the seekers, and the quietly obsessed.{{/if}}
        </p>
        <a class="ae-cta" href="#latest"><span>// EXPLORE ARCHIVE</span><b>+</b></a>
    </div>

    <div class="ae-hero-visual" aria-hidden="true">
        <div class="ae-hero-tag">
            <strong>AETHER-01</strong>
            <span>THE ARCANE ARCHIVE</span>
            <span>BUILT FOR SEEKERS</span>
            <em>&gt;&gt;</em>
        </div>
        <svg class="ae-board" viewBox="0 0 400 300" fill="none">
            <defs>
                <filter id="ae-glow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            </defs>
            <g filter="url(#ae-glow)">
                <path d="M60 70 L300 40 L360 200 L120 260 Z" fill="#101012" stroke="#a855f7" stroke-width="2"/>
            </g>
            <path d="M120 110 L270 90 L310 190 L150 220 Z" stroke="#2f2f35" stroke-width="1.5"/>
            <rect x="185" y="125" width="60" height="50" transform="rotate(-8 215 150)" fill="#18181b" stroke="#c6f135" stroke-width="2"/>
            <circle cx="215" cy="150" r="8" stroke="#c6f135" stroke-width="2"/>
            <path d="M90 82l12-1.5M104 90l12-1.5M118 98l12-1.5M280 52l12-1.5M294 60l12-1.5M308 68l12-1.5" stroke="#6b6b73" stroke-width="3"/>
            <circle cx="95" cy="205" r="6" stroke="#a855f7" stroke-width="2"/>
            <circle cx="340" cy="190" r="6" stroke="#a855f7" stroke-width="2"/>
        </svg>
    </div>
</section>

{{!-- LATEST + NEWS --}}
<section class="ae-row">
    <div class="ae-row-main">
        <div class="ae-panel ae-latest">
            <div class="ae-panel-label">// LATEST POST</div>
            {{#get "posts" limit="1"}}
                {{#foreach posts}}
                <a class="ae-latest-line" href="{{url}}">
                    <span class="ae-purple">{{date format="MM-DD"}}</span>
                    <span class="ae-latest-title">{{title}}</span>
                    <span class="ae-dim">by {{primary_author.name}} &middot; {{date published_at timeago="true"}}</span>
                </a>
                {{/foreach}}
            {{/get}}
        </div>

        <div class="ae-features">
            <div class="ae-feature-card">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></svg>
                <i></i><h3>OPEN MINDS</h3>
                <p>Ideas shared freely. Research, notes, and field logs, written so you can learn, question, and build on them.</p>
                <span>&rarr;</span>
            </div>
            <div class="ae-feature-card">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="14" height="14"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>
                <i></i><h3>SEEKER FIRST</h3>
                <p>Made for real curiosity. No filler, no noise, just the material that matters.</p>
                <span>&rarr;</span>
            </div>
            <div class="ae-feature-card">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6M15 14.5c3 0 6 1.7 6 5.5"/></svg>
                <i></i><h3>SHARED JOURNEY</h3>
                <p>A community of readers and writers. Everyone belongs, every voice adds to the map.</p>
                <span>&rarr;</span>
            </div>
            <div class="ae-feature-card">
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16"/><path d="M7 10l3 2-3 2M12 15h5"/></svg>
                <i></i><h3>DOCUMENTED</h3>
                <p>From first steps to deep dives. Documentation that does not just explain, it empowers.</p>
                <span>&rarr;</span>
            </div>
        </div>
    </div>

    <aside class="ae-news ae-panel">
        <div class="ae-panel-label">// NEWS FEED</div>
        {{#get "posts" limit="3"}}
            {{#foreach posts}}
            <a class="ae-news-item" href="{{url}}">
                <time>{{date format="YYYY-MM-DD"}}</time>
                <span>{{title}}</span>
                <em>&gt;&gt;</em>
            </a>
            {{/foreach}}
        {{/get}}
        <a class="ae-news-all" href="{{@site.url}}/rss/">VIEW ALL NEWS &rarr;</a>
    </aside>
</section>

{{!-- POST GRID --}}
<section class="ae-section" id="latest">
    <h2 class="ae-page-title">// LATEST_TRANSMISSIONS</h2>
    <div class="ae-grid">
        {{#foreach posts}}{{> "ae-card"}}{{/foreach}}
    </div>
    {{pagination}}
</section>

{{/is}}
